<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/month_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="Kalender" />
        <ImageView
            android:id="@+id/month_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:contentDescription="Neuer Termin"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>
    <ImageView
        android:id="@+id/month_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Monatsübersicht" />
</LinearLayout>
